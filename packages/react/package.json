{
  "name": "@blvdesign/soft-optics-react",
  "version": "0.1.0",
  "description": "React bindings for Soft Optics Shader.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blvdesign/SoftOpticsShader.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/blvdesign/SoftOpticsShader#readme",
  "bugs": {
    "url": "https://github.com/blvdesign/SoftOpticsShader/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "prepack": "pnpm build",
    "test": "vitest",
    "test:run": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@blvdesign/soft-optics": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=19.0.0 <20",
    "react-dom": ">=19.0.0 <20"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.17",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "jsdom": "^26.1.0",
    "tsup": "^8.5.1"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
